# Supabase (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never expose

# Admin panel login (/admin)
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=choose-a-strong-password

# Optional: where PDF fonts are served from if the local files are missing in
# the serverless function (defaults to <site URL>/fonts on Netlify).
# PDF_FONT_BASE_URL=https://your-site.netlify.app/fonts
